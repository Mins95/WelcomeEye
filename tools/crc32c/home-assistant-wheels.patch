diff --git a/builder/pip.py b/builder/pip.py
index b8b4ef6..8a78334 100644
--- a/builder/pip.py
+++ b/builder/pip.py
@@ -22,0 +23,3 @@ def build_wheels_package(
+    if package.split("=", 1)[0].replace("_", "-").lower() == "google-crc32c":
+        # A previous sdist build may have cached the pure-Python fallback.
+        build_env["PIP_NO_CACHE_DIR"] = "true"
diff --git a/builder/wheel.py b/builder/wheel.py
index 75b8130..94bd694 100644
--- a/builder/wheel.py
+++ b/builder/wheel.py
@@ -80,2 +80,7 @@ def fix_wheels_unmatch_requirements(wheels_folder: Path) -> dict[str, AwesomeVer
-        if check_abi_platform(package["abi"], package["plat"]):
-            continue
+        # google-crc32c silently builds a pure Python wheel when libcrc32c
+        # headers are absent. Existing cached pure wheels must also be rebuilt.
+        crc32c_fallback = (
+            package["name"] == "google_crc32c" and package["plat"] == "any"
+        )
+        if not crc32c_fallback and check_abi_platform(package["abi"], package["plat"]):
+            continue
diff --git a/tests/test_pip.py b/tests/test_pip.py
index 87f9143..f8beb69 100644
--- a/tests/test_pip.py
+++ b/tests/test_pip.py
@@ -3,0 +4 @@ from pathlib import Path
+from unittest.mock import patch
@@ -7,0 +9,10 @@ from builder import pip
+def test_crc32c_rebuild_ignores_cached_pure_wheel(tmp_path: Path) -> None:
+    """Forced CRC source rebuild cannot reuse a cached Python fallback."""
+    with patch("builder.pip.run_command") as command:
+        pip.build_wheels_package(
+            "google_crc32c==1.8.0", "https://example.invalid", tmp_path,
+            "google_crc32c", 60,
+        )
+    assert command.call_args.kwargs["env"]["PIP_NO_CACHE_DIR"] == "true"
+
+
diff --git a/tests/test_wheel.py b/tests/test_wheel.py
index ab1f511..18f006d 100644
--- a/tests/test_wheel.py
+++ b/tests/test_wheel.py
@@ -123,0 +124,11 @@ def test_fix_wheel_unmatch(tmp_path: Path) -> None:
+
+
+def test_crc32c_pure_fallback_rebuilt(tmp_path: Path) -> None:
+    """A cached portable fallback must not stand in for the native CRC wheel."""
+    fallback = tmp_path / "google_crc32c-1.8.0-py3-none-any.whl"
+    native = tmp_path / "google_crc32c-1.8.0-cp310-cp310-musllinux_1_2_x86_64.whl"
+    fallback.touch()
+    native.touch()
+    assert wheel.fix_wheels_unmatch_requirements(tmp_path) == {"google_crc32c": "1.8.0"}
+    assert not fallback.exists()
+    assert native.exists()
